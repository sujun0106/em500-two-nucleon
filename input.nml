! Select the calculation and physical system explicitly.
! This version implements only the fixed-EM500 deuteron bound state.
! No incident scattering energy is used by this bound-state calculation.
&calculation_input
  calculation = 'deuteron_bound_state'
  system = 'np'
  interaction = 'EM500'
  n_grid = 100
  pmax_MeV = 1000.0
  write_matrices = .false.
/
