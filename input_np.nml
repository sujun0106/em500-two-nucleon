! Neutron beam on stationary proton; CM outgoing-neutron angles.
&calculation_input
  calculation = 'np_scattering'
  system = 'np'
  interaction = 'EM500'
  energy_lab_MeV = 96.0
  kinematics = 'relativistic'
  n_grid = 96
  pmax_MeV = 1000.0
  jmax = 32
  theta_min_deg = 0.0
  theta_max_deg = 180.0
  n_angles = 181
  write_amplitudes = .true.
/
