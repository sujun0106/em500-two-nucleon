  "source_bibliography": [
    {
      "subentry": "F1169002",
      "entry": {
        "TITLE": [
          "Proton-proton scattering at 98 and 142 MeV."
        ],
        "AUTHOR": [
          "(A.E.Taylor,E.Wood,L.Bird)"
        ],
        "INSTITUTE": [
          "(2UK HAR)"
        ],
        "REFERENCE": [
          "(J,NP,16,320,1960)"
        ],
        "FACILITY": [
          "(CYCLO,2UK HAR)"
        ],
        "SAMPLE": [
          "Two liquid hydrogen targets were used which had total\nsurface  densities of 1.31 and 1.11 g/cm2. The\nevaporation rate from the target was about 10 cm3 of\nliquid hydrogen per hour when most of the ortho-\nparahydrogen conversion had taken place."
        ],
        "DETECTOR": [
          "(TELES) A triple coincidence range telescope was used\nto detect the scattered protons and the telescope\nabsorber was changed in order to maintain constant\nefficiency of detection for the different scattering\nangles. The counter telescope was mounted on an arm\nwhich could be swung from side to side of the beam\ndirection and whose pivot was carefully set in the\ncentre of the collimated beam."
        ],
        "CORRECTION": [
          "To obtain the true efficiency for any scattering\nangle a small correction was added to the measured\nvalue for those protons which were lost before being\ndetected by the telescope. This correction was\nslightly energy sensitive amounting to 0.2% at 10 degr.\nand 0.6% at 40 degrees for the 98 MeV determination."
        ],
        "ERR-ANALYS": [
          "(DATA-ERR1) Absolute scale error\n(DATA-ERR2) Total relative error\n(ERR-1)  Counting errors\n(ERR-2)  Uncertainty in measurement of the detector\nefficiency\n(ERR-3)  Possible deviation from an angle cosecant\ndependence\n(ERR-4)  Fluctuation in the ionization chamber\ncalibration\n(ERR-5)  Uncertainty in the corrections applied to the\nmeasured detector efficiency\n(DATA-ERR3,3.,4.)The relative error between the\nabsolute scales of the separate determinations"
        ],
        "HISTORY": [
          "(20121010C)"
        ]
      },
      "subentry_bib": {
        "REACTION": [
          "(1-H-1(P,EL)1-H-1,,DA)"
        ],
        "INC-SOURCE": [
          "Unpolarized beam."
        ],
        "FLAG": [
          "(1.) Small angle telescope was used.\n(2.) Large angle telescope was used."
        ],
        "STATUS": [
          "(TABLE) Tbl.1,2."
        ]
      }
