 ENERGY_LAB_MEV=  270.80000000000001     ,
 KINEMATICS="relativistic                                                    ",
 JMAX=32         ,
 THETA_MIN_DEG= 0.25000000000000000     ,
 THETA_MAX_DEG=  179.75000000000000     ,
 N_ANGLES=719        ,
 WRITE_AMPLITUDES=T,
 COULOMB_RADIUS_FM=  16.000000000000000     ,
 N_COULOMB_POINTS=192        ,
 /
