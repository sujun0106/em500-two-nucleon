&CALCULATION_INPUT
 CALCULATION="deuteron_bound_state                                            ",
 SYSTEM="np                                                              ",
 INTERACTION="EM500                                                           ",
 N_GRID=192        ,
 PMAX_MEV=  1000.0000000000000     ,
 WRITE_MATRICES=F,
 ENERGY_LAB_MEV= -1.0000000000000000     ,
 KINEMATICS="nonrelativistic                                                 ",
 JMAX=8          ,
 THETA_MIN_DEG=  0.0000000000000000     ,
 THETA_MAX_DEG=  180.00000000000000     ,
 N_ANGLES=181        ,
 WRITE_AMPLITUDES=T,
 COULOMB_RADIUS_FM=  15.000000000000000     ,
 N_COULOMB_POINTS=192        ,
 WRITE_COORDINATE=T,
 COORDINATE_RMAX_FM=  60.000000000000000     ,
 COORDINATE_N_INTERVALS=6000       ,
 /
