# Compilation products (retain local files; exclude from Git).
/*.x
/*.mod
/*.smod
/*.o
/app/**/*.x
/app/**/*.mod
/app/**/*.smod
/app/**/*.o
/app/**/*.a

# Ordinary runs; retain the three requested comparison collections.
/output/*
!/output/d_com_exp_cal/
!/output/np_com_exp_cal/
!/output/pp_com_exp_cal/

# Locks and runtime files in the package root.
/.run.lock/
/.archive.lock/
/run_input.nml
/run_status.txt
/run.log
/run_metadata.txt
/job.pid
/deuteron_status.txt
/deuteron_input.nml
/deuteron_summary.txt
/deuteron_wavefunction.csv
/deuteron_matrices.csv
/deuteron_observables.dat
/deuteron_coordinate_wavefunction.csv
/np_input.nml
/np_summary.txt
/np_partial_waves.csv
/np_on_shell.csv
/np_angular_distribution.csv
/np_spin_amplitudes.csv
/np_j_convergence.csv
/pp_input.nml
/pp_summary.txt
/pp_partial_waves.csv
/pp_nuclear_s.csv
/pp_angular_distribution.csv
/pp_spin_amplitudes.csv
/pp_j_convergence.csv

# Document/cache products, not the delivered PDF/figures.
__pycache__/
*.py[cod]
/docs/*.aux
/docs/*.log
/docs/*.toc
/docs/*.out
/docs/*.synctex.gz
/docs/.build/
.DS_Store
Thumbs.db

# COUL90 is downloaded by each user; do not redistribute the source.
/app/coulomb/coul90.f
/app/coulomb/.coul90.download.*
